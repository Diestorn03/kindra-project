# Contraseña para entrar al panel privado (ustedes dos)
ADMIN_PASSWORD=cambiar-esta-clave
# Cadena aleatoria larga para firmar la sesión (cualquier texto largo)
AUTH_SECRET=cambiar-por-una-cadena-larga-aleatoria

# Dirección pública del sistema (para armar los enlaces de briefing)
NEXT_PUBLIC_URL_BASE=http://localhost:3000
# WhatsApp de la agencia para el botón "Escríbenos" del sitio público (solo números, con código de país). Vacío = sin botón.
NEXT_PUBLIC_WHATSAPP=

# --- Supabase (opcional). Si se dejan vacíos, el sistema guarda en archivos locales (carpeta data/). ---
# Al crear el proyecto en supabase.com: ejecutar supabase/schema.sql en el editor SQL y copiar estos valores.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
